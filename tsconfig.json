{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2022",
		"outDir": "out",
		"lib": [
			"es2022"
		],
		"sourceMap": true,
		"rootDir": ".",
		"typeRoots": [
			"./node_modules/@types"
		],
		"types": [
			"node",
			"vscode"
		]
	},
	"typeAcquisition": {
		"enable": true
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
