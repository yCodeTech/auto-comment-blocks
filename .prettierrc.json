{
	"useTabs": true,
	"tabWidth": 4,
	"semi": true,
	"printWidth": 150,
	"bracketSameLine": true,
	"bracketSpacing": false,
	"multilineArraysWrapThreshold": 4,
	"overrides": [
		{
			"files": [
				"*.json",
				"*.jsonc"
			],
			"options": {
				"printWidth": 5
			}
		},
		{
			"files": [
				"*.yml"
			],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		},
		{
			"files": [
				"*.js",
				"*.ts"
			],
			"options": {
				"quoteProps": "consistent",
				"trailingComma": "es5"
			}
		}
	],
	"plugins": [
		"prettier-plugin-multiline-arrays"
	]
}
